{
  "namespace": "hud",

  // Behemoth custom boss bars (design doc L45, docs/converting.md section 6).
  // Every boss bar gets an image picked by the name on the bar:
  //   textures/behemoth/bossbars/<name>.png
  // - A boss with custom art has a bar KEY as its name (minecraft:boss name "bhmbar_<id>", no name
  //   tag, config display.barKey). The bar text is hidden for those names: the art carries the name.
  // - Any other bar shows its name as usual (the game strips colour codes, so <name> is the plain
  //   name). Boss packs ship an empty image for it; the framework ships empty images for the vanilla
  //   Wither and Ender Dragon. A name without a file shows the game's missing-texture square.
  // The canvas is 512x128 GUI units centred on the vanilla bar (bar at x 165-347, y 60-65), so it
  // scales with the screen and GUI scale like the vanilla bar. The converter places the boss's
  // bossbar.png on it (size and position from behemoth.json bossbar_layout).

  "boss_name_panel": {
    "layer": 30,
    "bindings": [
      { "binding_name": "#bossName", "binding_type": "collection", "binding_collection_name": "boss_bars" },
      {
        "binding_type": "view",
        "source_property_name": "((#bossName - 'bhmbar_') = #bossName)",
        "target_property_name": "#visible"
      }
    ]
  },

  "boss_health_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "bhm_boss_bar_image": {
              "type": "image",
              "size": [ 512, 128 ],
              "anchor_from": "top_middle",
              "anchor_to": "top_middle",
              "offset": [ 0, -50 ],
              "layer": 20,
              "allow_debug_missing_texture": false,
              "bindings": [
                { "binding_name": "#bossName", "binding_type": "collection", "binding_collection_name": "boss_bars" },
                {
                  "binding_type": "view",
                  "source_property_name": "('textures/behemoth/bossbars/' + #bossName)",
                  "target_property_name": "#texture"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
