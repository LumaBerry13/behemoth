{
  "namespace": "hud",

  // Behemoth custom boss bars: an image drawn over the vanilla boss bar, chosen by the
  // name the bar shows: textures/behemoth/bossbars/<boss bar name>.png (boss packs ship it;
  // the converter copies <MOB>/bossbar.png there). Bars without an image show nothing extra.
  // The image covers the whole 182x20 boss panel: name text at the top, bar at y 10-15
  // (template: docs/bossbar_template.png).
  "boss_health_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "bhm_boss_bar_overlay": {
              "type": "image",
              "size": [ 182, 20 ],
              "anchor_from": "top_middle",
              "anchor_to": "top_middle",
              "layer": 20,
              "allow_debug_missing_texture": false,
              "bindings": [
                { "binding_name": "#bossName", "binding_type": "collection", "binding_collection_name": "boss_bars" },
                {
                  "binding_type": "view",
                  "source_property_name": "('textures/behemoth/bossbars/' + #bossName)",
                  "target_property_name": "#texture"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
