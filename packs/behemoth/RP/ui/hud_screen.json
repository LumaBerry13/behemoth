{
  "namespace": "hud",

  // Behemoth custom boss bars (design doc L45, docs/converting.md section 6).
  // Every boss bar gets an image picked by the name on the bar:
  //   textures/behemoth/bossbars/<name>.png
  // The game strips colour codes from boss bar names, so <name> is the plain name.
  // Boss packs ship that file (the converter writes the boss's bossbar.png there, or an empty
  // transparent image). The framework ships empty images for the vanilla Wither and Ender Dragon.
  // A name without a file shows the game's missing-texture square.
  // The canvas is 256x64 GUI units centred on the vanilla bar (bar at x 37-219, y 28-33), so it
  // scales with the screen and GUI scale like the vanilla bar; the boss name is drawn above it.

  "boss_name_panel": {
    "layer": 30
  },

  "boss_health_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "bhm_boss_bar_image": {
              "type": "image",
              "size": [ 256, 64 ],
              "anchor_from": "top_middle",
              "anchor_to": "top_middle",
              "offset": [ 0, -18 ],
              "layer": 20,
              "allow_debug_missing_texture": false,
              "bindings": [
                { "binding_name": "#bossName", "binding_type": "collection", "binding_collection_name": "boss_bars" },
                {
                  "binding_type": "view",
                  "source_property_name": "('textures/behemoth/bossbars/' + #bossName)",
                  "target_property_name": "#texture"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
