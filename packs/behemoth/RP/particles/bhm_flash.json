{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/behemoth/particles/flash"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.count > 0 ? variable.count : 1)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.lifetime > 0 ? variable.lifetime : 0.25)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 1.5) * (0.4 + 0.6 * (variable.particle_age / variable.particle_lifetime))",
          "(variable.size > 0 ? variable.size : 1.5) * (0.4 + 0.6 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.color.a > 0 ? variable.color.r : 1)",
          "(variable.color.a > 0 ? variable.color.g : 1)",
          "(variable.color.a > 0 ? variable.color.b : 0.9)",
          "(variable.color.a > 0 ? variable.color.a : 1) * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
