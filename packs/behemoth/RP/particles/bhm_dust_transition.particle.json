{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:dust_transition",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/behemoth/particles/dot"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.count = variable.count ?? 1; variable.lifetime = variable.lifetime ?? 1; variable.size = variable.size ?? 0.08; variable.color_r = variable.color_r ?? 0; variable.color_g = variable.color_g ?? 1; variable.color_b = variable.color_b ?? 1; variable.color_a = variable.color_a ?? 1; variable.color2_r = variable.color2_r ?? variable.color_r; variable.color2_g = variable.color2_g ?? variable.color_g; variable.color2_b = variable.color2_b ?? variable.color_b; variable.color2_a = variable.color2_a ?? variable.color_a;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "math.random(-1, 1)",
          "math.random(-1, 1)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.lifetime"
      },
      "minecraft:particle_initial_speed": 0.15,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (0.5 + 0.5 * (1 - variable.particle_age / variable.particle_lifetime))",
          "variable.size * (0.5 + 0.5 * (1 - variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(variable.color_r, variable.color2_r, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(variable.color_g, variable.color2_g, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(variable.color_b, variable.color2_b, (variable.particle_age / variable.particle_lifetime))",
          "math.lerp(variable.color_a, variable.color2_a, (variable.particle_age / variable.particle_lifetime)) * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
