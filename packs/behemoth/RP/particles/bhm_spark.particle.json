{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/behemoth/particles/spark"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.count = variable.count ?? 8; variable.lifetime = variable.lifetime ?? 0.5; variable.speed = variable.speed ?? 5; variable.size = variable.size ?? 0.06; variable.color_r = variable.color_r ?? 1; variable.color_g = variable.color_g ?? 0.8; variable.color_b = variable.color_b ?? 0.3; variable.color_a = variable.color_a ?? 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.1,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.lifetime * math.random(0.6, 1)"
      },
      "minecraft:particle_initial_speed": "variable.speed * math.random(0.5, 1)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -9,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (1 - variable.particle_age / variable.particle_lifetime)",
          "variable.size * (1 - variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color_r",
          "variable.color_g",
          "variable.color_b",
          "variable.color_a * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
