{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:telegraph",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/behemoth/particles/disc"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.count > 0 ? variable.count : 1)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.lifetime > 0 ? variable.lifetime : 1.0)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 3) * math.min(1, variable.particle_age * 8)",
          "(variable.size > 0 ? variable.size : 3) * math.min(1, variable.particle_age * 8)"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.color.a > 0 ? variable.color.r : 1)",
          "(variable.color.a > 0 ? variable.color.g : 0.2)",
          "(variable.color.a > 0 ? variable.color.b : 0.2)",
          "(variable.color.a > 0 ? variable.color.a : 1) * (0.35 + 0.2 * math.sin(variable.particle_age * 720))"
        ]
      }
    }
  }
}
