{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:swirl",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/behemoth/particles/dot"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.count > 0 ? variable.count : 24)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.lifetime > 0 ? variable.lifetime : 1.2)"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(variable.particle_random_1 * 360 + variable.particle_age * (variable.speed > 0 ? variable.speed : 360)) * (variable.radius > 0 ? variable.radius : 1.5)",
          "variable.particle_age * (variable.rise > 0 ? variable.rise : 2)",
          "math.sin(variable.particle_random_1 * 360 + variable.particle_age * (variable.speed > 0 ? variable.speed : 360)) * (variable.radius > 0 ? variable.radius : 1.5)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 0.07) * (1 - variable.particle_age / variable.particle_lifetime)",
          "(variable.size > 0 ? variable.size : 0.07) * (1 - variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.color.a > 0 ? variable.color.r : 0.7)",
          "(variable.color.a > 0 ? variable.color.g : 0.5)",
          "(variable.color.a > 0 ? variable.color.b : 1)",
          "(variable.color.a > 0 ? variable.color.a : 1) * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
