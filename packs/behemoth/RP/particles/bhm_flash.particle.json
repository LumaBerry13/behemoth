{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:flash",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/behemoth/particles/flash"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.count = variable.count ?? 1; variable.lifetime = variable.lifetime ?? 0.25; variable.size = variable.size ?? 1.5; variable.color_r = variable.color_r ?? 1; variable.color_g = variable.color_g ?? 1; variable.color_b = variable.color_b ?? 0.9; variable.color_a = variable.color_a ?? 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.lifetime"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (0.4 + 0.6 * (variable.particle_age / variable.particle_lifetime))",
          "variable.size * (0.4 + 0.6 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color_r",
          "variable.color_g",
          "variable.color_b",
          "variable.color_a * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
