{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/behemoth/particles/smoke"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.count = variable.count ?? 3; variable.lifetime = variable.lifetime ?? 1.5; variable.rise = variable.rise ?? 1; variable.size = variable.size ?? 0.3; variable.color_r = variable.color_r ?? 0.45; variable.color_g = variable.color_g ?? 0.45; variable.color_b = variable.color_b ?? 0.45; variable.color_a = variable.color_a ?? 0.8;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.lifetime * math.random(0.7, 1)"
      },
      "minecraft:particle_initial_speed": 0.4,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "variable.rise",
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (0.6 + 0.8 * (variable.particle_age / variable.particle_lifetime))",
          "variable.size * (0.6 + 0.8 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color_r",
          "variable.color_g",
          "variable.color_b",
          "variable.color_a * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
