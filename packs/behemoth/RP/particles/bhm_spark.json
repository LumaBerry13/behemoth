{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/behemoth/particles/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.count > 0 ? variable.count : 8)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.1,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.lifetime > 0 ? variable.lifetime : 0.5) * math.random(0.6, 1)"
      },
      "minecraft:particle_initial_speed": "(variable.speed > 0 ? variable.speed : 5) * math.random(0.5, 1)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -9,
          0
        ],
        "linear_drag_coefficient": 3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 0.06) * (1 - variable.particle_age / variable.particle_lifetime)",
          "(variable.size > 0 ? variable.size : 0.06) * (1 - variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.color.a > 0 ? variable.color.r : 1)",
          "(variable.color.a > 0 ? variable.color.g : 0.8)",
          "(variable.color.a > 0 ? variable.color.b : 0.3)",
          "(variable.color.a > 0 ? variable.color.a : 1) * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
