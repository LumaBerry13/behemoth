{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:telegraph",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/behemoth/particles/disc"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.count = variable.count ?? 1; variable.lifetime = variable.lifetime ?? 1; variable.size = variable.size ?? 3; variable.color_r = variable.color_r ?? 1; variable.color_g = variable.color_g ?? 0.2; variable.color_b = variable.color_b ?? 0.2; variable.color_a = variable.color_a ?? 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.lifetime"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * math.min(1, variable.particle_age * 8)",
          "variable.size * math.min(1, variable.particle_age * 8)"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color_r",
          "variable.color_g",
          "variable.color_b",
          "variable.color_a * (0.45 + 0.2 * math.sin(variable.particle_age * 720))"
        ]
      }
    }
  }
}
