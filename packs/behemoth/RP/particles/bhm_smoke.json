{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:smoke",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/behemoth/particles/smoke"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.count > 0 ? variable.count : 3)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.lifetime > 0 ? variable.lifetime : 1.5) * math.random(0.7, 1)"
      },
      "minecraft:particle_initial_speed": 0.4,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          "(variable.rise > 0 ? variable.rise : 1.0)",
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 0.3) * (0.6 + 0.8 * (variable.particle_age / variable.particle_lifetime))",
          "(variable.size > 0 ? variable.size : 0.3) * (0.6 + 0.8 * (variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.color.a > 0 ? variable.color.r : 0.45)",
          "(variable.color.a > 0 ? variable.color.g : 0.45)",
          "(variable.color.a > 0 ? variable.color.b : 0.45)",
          "(variable.color.a > 0 ? variable.color.a : 0.8) * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
