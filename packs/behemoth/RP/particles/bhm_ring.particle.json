{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:ring",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/behemoth/particles/ring"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.count = variable.count ?? 1; variable.lifetime = variable.lifetime ?? 0.6; variable.size = variable.size ?? 3; variable.color_r = variable.color_r ?? 1; variable.color_g = variable.color_g ?? 1; variable.color_b = variable.color_b ?? 1; variable.color_a = variable.color_a ?? 1;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "variable.count"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "variable.lifetime"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size * (variable.particle_age / variable.particle_lifetime)",
          "variable.size * (variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.color_r",
          "variable.color_g",
          "variable.color_b",
          "variable.color_a * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
