{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bhm:dust",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/behemoth/particles/dot"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": "(variable.count > 0 ? variable.count : 1)"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "math.random(-1, 1)",
          "math.random(-1, 1)",
          "math.random(-1, 1)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "(variable.lifetime > 0 ? variable.lifetime : 1.0)"
      },
      "minecraft:particle_initial_speed": 0.15,
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.size > 0 ? variable.size : 0.08) * (0.5 + 0.5 * (1 - variable.particle_age / variable.particle_lifetime))",
          "(variable.size > 0 ? variable.size : 0.08) * (0.5 + 0.5 * (1 - variable.particle_age / variable.particle_lifetime))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(variable.color.a > 0 ? variable.color.r : 1)",
          "(variable.color.a > 0 ? variable.color.g : 0.1)",
          "(variable.color.a > 0 ? variable.color.b : 0.1)",
          "(variable.color.a > 0 ? variable.color.a : 1) * (1 - variable.particle_age / variable.particle_lifetime)"
        ]
      }
    }
  }
}
