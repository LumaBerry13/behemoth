{
  // Type-checks the plain-JS framework against the pinned @minecraft/server typings.
  // Nothing is emitted: the BP ships the .js sources as-is.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["packs/*/BP/scripts/**/*.js", "packs/*/BP/scripts/**/*.d.ts"],
  "exclude": ["packs/*/BP/scripts/adapter/vendor/**/*.js"]
}
