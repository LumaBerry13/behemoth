{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "mb:test_boss",
      "is_spawnable": true,
      "is_summonable": true,
      "properties": {
        "mb:phase": { "type": "int", "range": [0, 15], "default": 1, "client_sync": true },
        "mb:visibility": { "type": "int", "range": [0, 255], "default": 0, "client_sync": true },
        "mb:anim_speed": { "type": "float", "range": [0.0, 10.0], "default": 1.0, "client_sync": true }
      }
    },

    "component_groups": {
      "mb:idle": {
        "minecraft:behavior.random_stroll": { "priority": 6, "speed_multiplier": 0.8 },
        "minecraft:behavior.look_at_player": { "priority": 7, "look_distance": 16.0, "probability": 0.1 },
        "minecraft:behavior.random_look_around": { "priority": 8 }
      },
      "mb:chase": {
        "minecraft:behavior.hurt_by_target": {
          "priority": 1,
          "entity_types": { "filters": { "test": "is_family", "subject": "other", "value": "player" } }
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 2,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 32.0,
          "entity_types": [
            { "filters": { "test": "is_family", "subject": "other", "value": "player" }, "max_dist": 32 }
          ]
        },
        "minecraft:behavior.melee_attack": { "priority": 3, "speed_multiplier": 1.0, "track_target": true },
        "minecraft:attack": { "damage": 1 },
        "minecraft:behavior.look_at_target": { "priority": 4 }
      },
      "mb:frozen": {
        "minecraft:movement": { "value": 0.0 }
      },
      "mb:invulnerable": {
        "minecraft:damage_sensor": {
          "triggers": [ { "cause": "all", "deals_damage": "no" } ]
        }
      },
      "mb:despawn": {
        "minecraft:instant_despawn": {}
      }
    },

    "components": {
      "minecraft:type_family": { "family": [ "mb_boss", "mob" ] },
      "minecraft:health": { "value": 300, "max": 300 },
      "minecraft:boss": { "should_darken_sky": false, "hud_range": 48, "name": "Test Boss" },
      "minecraft:nameable": { "always_show": true, "allow_name_tag_renaming": false },
      "minecraft:persistent": {},
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": true },
      "minecraft:collision_box": { "width": 0.9, "height": 2.7 },
      "minecraft:scale": { "value": 1.5 },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:movement": { "value": 0.25 },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": { "can_path_over_water": true, "avoid_damage_blocks": true },
      "minecraft:follow_range": { "value": 48, "max": 48 },
      "minecraft:fire_immune": true,
      "minecraft:damage_sensor": {
        "triggers": [ { "cause": "fall", "deals_damage": "no" } ]
      },
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0, "breathes_water": true }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": [ "mb:idle" ] }
      },
      "mb:set_idle": {
        "remove": { "component_groups": [ "mb:chase", "mb:frozen" ] },
        "add": { "component_groups": [ "mb:idle" ] }
      },
      "mb:set_chase": {
        "remove": { "component_groups": [ "mb:idle", "mb:frozen" ] },
        "add": { "component_groups": [ "mb:chase" ] }
      },
      "mb:set_frozen": {
        "remove": { "component_groups": [ "mb:idle", "mb:chase" ] },
        "add": { "component_groups": [ "mb:frozen" ] }
      },
      "mb:invuln_on": {
        "add": { "component_groups": [ "mb:invulnerable" ] }
      },
      "mb:invuln_off": {
        "remove": { "component_groups": [ "mb:invulnerable" ] }
      },
      "mb:despawn": {
        "add": { "component_groups": [ "mb:despawn" ] }
      }
    }
  }
}
