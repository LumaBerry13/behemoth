{
  "name": "mythic-bedrock",
  "version": "0.1.0",
  "private": true,
  "description": "MythicMobs-style boss framework for Minecraft Bedrock (Script API)",
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "validate": "node tools/validate.mjs",
    "sim": "node tools/sim/run.mjs",
    "sim:hits": "node tools/sim/hits.mjs",
    "sim:scenarios": "node tools/sim/scenarios.mjs",
    "convert": "python converter/convert.py",
    "test:converter": "python -m pytest converter/tests -q",
    "deploy": "node tools/deploy.mjs"
  },
  "devDependencies": {
    "@minecraft/server": "2.10.0",
    "typescript": "^7.0.2"
  }
}
